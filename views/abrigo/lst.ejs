<%- include("../cabecalho.ejs") %>

<main class="flex-grow-1 container py-3">

    <div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
        <div>
            <h1>Abrigos</h1>
            <p class="text-muted">Cadastro dos abrigos parceiros da ONG</p>
        </div>
        <a href="/abrigo/add" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Abrigo
        </a>
    </div>

    <!-- Pesquisa por nome -->
    <form method="post" action="/abrigo/lst" class="row g-2 mb-3">
        <div class="col-md-6">
            <input type="text" name="pesquisar" value="<%= pesquisar %>" maxlength="50" class="form-control"
                placeholder="Pesquisar por nome do abrigo">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Buscar</button>
            <a href="/abrigo/lst" class="btn btn-secondary">Limpar</a>
        </div>
    </form>

    <% if (abrigos.length === 0) { %>
        <div class="alert alert-info">
            <% if (pesquisar) { %>
                Nenhum abrigo encontrado para "<%= pesquisar %>".
            <% } else { %>
                Nenhum abrigo cadastrado.
            <% } %>
        </div>
    <% } else { %>
        <!-- Tabela de abrigos -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome do Abrigo</th>
                        <th>Nome do Responsável</th>
                        <th>Endereço</th>
                        <th>Cidade</th>
                        <th>Telefone</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% abrigos.forEach(a => { %>
                        <tr>
                            <td><%= a.nome %></td>
                            <td><%= a.responsavel %></td>
                            <td><%= a.endereco %></td>
                            <td><%= a.cidade %></td>
                            <td><%= a.telefone %></td>
                            <td class="text-end">
                                <a href="/abrigo/edt/<%= a._id %>" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="/abrigo/del/<%= a._id %>" class="d-inline"
                                    onsubmit="return confirm('Excluir este abrigo?');">
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>

</main>

<%- include("../rodape.ejs") %>