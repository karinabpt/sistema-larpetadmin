<%- include("../cabecalho.ejs") %>

<main class="flex-grow-1 container py-3">

    <div class="page-header mb-4">
        <h1><i class="bi bi-pencil-square"></i> Editar Abrigo</h1>
        <p class="text-muted">Altere os dados do abrigo parceiro</p>
    </div>

    <% if (erro) { %>
        <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <div class="card p-4 shadow-sm">
        <form method="post" action="/abrigo/edt/<%= abrigo._id %>" autocomplete="off">
            <div class="mb-3">
                <label for="id" class="form-label">ID do abrigo</label>
                <input type="text" class="form-control" id="id" value="<%= abrigo._id %>" readonly>
            </div>
            <div class="mb-3">
                <label for="nome" class="form-label">Nome do abrigo <span class="text-danger">*</span></label>
                <input type="text" minlength="3" maxlength="30" class="form-control" id="nome" name="nome" value="<%= abrigo.nome || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="responsavel" class="form-label">Nome do responsável <span class="text-danger">*</span></label>
                <input type="text" minlength="3" maxlength="30" class="form-control" id="responsavel" name="responsavel" value="<%= abrigo.responsavel || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="endereco" class="form-label">Endereço</label>
                <input type="text" class="form-control" id="endereco" name="endereco" value="<%= abrigo.endereco || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="cidade" class="form-label">Cidade</label>
                <input type="text" class="form-control" id="cidade" name="cidade" value="<%= abrigo.cidade || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="telefone" class="form-label">Telefone</label>
                <input type="tel" class="form-control" id="telefone" name="telefone" value="<%= abrigo.telefone || '' %>" required>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar Alterações</button>
                <a href="/abrigo/lst" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>

</main>

<%- include("../rodape.ejs") %>